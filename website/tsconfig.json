{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@lib/*": [
        "../src/*"
      ],
      "health-components": [
        "../src/index.ts"
      ]
    },
    "target": "ES2020",
    "downlevelIteration": true
  },
  "exclude": [
    ".docusaurus",
    "build"
  ]
}
